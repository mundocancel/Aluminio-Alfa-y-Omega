/* ---------- RESET & BASE ---------- */
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#ffffff;
  --bg-soft:#f5f5f7;
  --fg:#1d1d1f;
  --fg-muted:#6e6e73;
  --accent:#0a84ff;
  --accent-2:#0066cc;
  --border:#e5e5ea;
  --radius:18px;
  --max:1180px;
  --shadow:0 8px 30px rgba(0,0,0,.08);
  --shadow-lg:0 20px 60px rgba(0,0,0,.12);
  --transition:all .4s cubic-bezier(.22,.61,.36,1);
}
html{scroll-behavior:smooth}
body{
  font-family:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
  color:var(--fg);background:var(--bg);line-height:1.5;
  -webkit-font-smoothing:antialiased;overflow-x:hidden;
}
img{max-width:100%;display:block}
a{color:inherit;text-decoration:none}
button{font-family:inherit;cursor:pointer;border:none;background:none}

/* ---------- HEADER ---------- */
.header{
  position:sticky;top:0;z-index:100;
  backdrop-filter:saturate(180%) blur(20px);
  -webkit-backdrop-filter:saturate(180%) blur(20px);
  background:rgba(255,255,255,.75);
  border-bottom:1px solid var(--border);
  transition:var(--transition);
}
.header.scrolled{box-shadow:0 2px 20px rgba(0,0,0,.06)}
.nav{
  max-width:var(--max);margin:0 auto;padding:14px 24px;
  display:flex;align-items:center;justify-content:space-between;gap:20px;
}
.logo{display:flex;align-items:center;gap:10px;font-weight:700;font-size:1.05rem;letter-spacing:-.02em}
.logo img{height:34px;width:auto}
.logo .logo-fallback{
  width:34px;height:34px;border-radius:9px;background:linear-gradient(135deg,#1d1d1f,#48484a);
  color:#fff;display:grid;place-items:center;font-weight:800;font-size:.85rem;
}
.nav-links{display:flex;gap:32px;font-size:.9rem;font-weight:500;color:var(--fg-muted)}
.nav-links a{transition:color .2s}
.nav-links a:hover{color:var(--fg)}
.nav-cta{
  background:var(--fg);color:#fff;padding:9px 20px;border-radius:999px;
  font-size:.85rem;font-weight:500;transition:var(--transition);
}
.nav-cta:hover{background:var(--accent);transform:translateY(-1px)}
.burger{display:none;width:34px;height:34px;flex-direction:column;justify-content:center;gap:6px;align-items:center}
.burger span{width:20px;height:1.5px;background:var(--fg);transition:var(--transition);border-radius:2px}
.burger.open span:nth-child(1){transform:translateY(7.5px) rotate(45deg)}
.burger.open span:nth-child(2){opacity:0}
.burger.open span:nth-child(3){transform:translateY(-7.5px) rotate(-45deg)}

@media(max-width:820px){
  .nav-links{
    position:fixed;top:64px;left:0;right:0;background:rgba(255,255,255,.98);
    flex-direction:column;padding:24px;gap:20px;font-size:1rem;
    transform:translateY(-120%);transition:var(--transition);border-bottom:1px solid var(--border);
  }
  .nav-links.open{transform:translateY(0)}
  .nav-links a{font-size:1rem;color:var(--fg)}
  .burger{display:flex}
  .nav-cta{display:none}
}

/* ---------- HERO ---------- */
.hero{
  position:relative;min-height:88vh;display:flex;align-items:center;
  background:radial-gradient(1200px 600px at 80% -10%,rgba(10,132,255,.08),transparent 60%),
             radial-gradient(900px 500px at 0% 100%,rgba(0,0,0,.04),transparent 60%),
             var(--bg-soft);
  overflow:hidden;
}
.hero-inner{
  max-width:var(--max);margin:0 auto;padding:80px 24px;width:100%;
  display:grid;grid-template-columns:1.1fr .9fr;gap:60px;align-items:center;
}
.hero-badge{
  display:inline-block;font-size:.75rem;font-weight:600;letter-spacing:.08em;
  text-transform:uppercase;color:var(--accent);
  padding:6px 14px;border:1px solid rgba(10,132,255,.25);border-radius:999px;
  background:rgba(10,132,255,.06);margin-bottom:22px;
}
.hero h1{
  font-size:clamp(2.2rem,5.5vw,4.2rem);font-weight:800;letter-spacing:-.03em;
  line-height:1.05;margin-bottom:22px;
}
.hero h1 .grad{
  background:linear-gradient(90deg,#1d1d1f 0%,#0a84ff 100%);
  -webkit-background-clip:text;background-clip:text;color:transparent;
}
.hero p{
  font-size:clamp(1rem,1.4vw,1.18rem);color:var(--fg-muted);
  max-width:520px;margin-bottom:34px;
}
.hero-actions{display:flex;gap:14px;flex-wrap:wrap}
.btn{
  display:inline-flex;align-items:center;gap:8px;padding:13px 26px;border-radius:999px;
  font-weight:600;font-size:.92rem;transition:var(--transition);border:1px solid transparent;
}
.btn-primary{background:var(--accent);color:#fff;box-shadow:0 6px 20px rgba(10,132,255,.3)}
.btn-primary:hover{background:var(--accent-2);transform:translateY(-2px);box-shadow:0 10px 28px rgba(10,132,255,.4)}
.btn-ghost{background:transparent;color:var(--fg);border:1px solid var(--border)}
.btn-ghost:hover{border-color:var(--fg);transform:translateY(-2px)}
.hero-visual{
  position:relative;height:440px;border-radius:24px;overflow:hidden;
  background:linear-gradient(160deg,#1d1d1f,#3a3a3c);
  box-shadow:var(--shadow-lg);
  display:grid;place-items:center;color:#fff;
}
.hero-visual img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.9}
.hero-visual .placeholder{text-align:center;padding:24px;z-index:1}
.hero-visual .placeholder svg{opacity:.4;margin-bottom:14px}
.hero-visual .placeholder p{font-size:.85rem;opacity:.7}

@media(max-width:900px){
  .hero-inner{grid-template-columns:1fr;gap:40px;padding:60px 22px;text-align:center}
  .hero p{margin-left:auto;margin-right:auto}
  .hero-actions{justify-content:center}
  .hero-visual{height:320px;order:-1}
}

/* ---------- SECTIONS GENERAL ---------- */
section{padding:100px 24px}
.container{max-width:var(--max);margin:0 auto}
.section-head{text-align:center;margin-bottom:56px}
.section-eyebrow{
  font-size:.78rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;
  color:var(--accent);margin-bottom:14px;
}
.section-head h2{
  font-size:clamp(1.8rem,4vw,2.8rem);font-weight:800;letter-spacing:-.03em;
  line-height:1.1;margin-bottom:14px;
}
.section-head p{color:var(--fg-muted);max-width:600px;margin:0 auto;font-size:1.02rem}

/* ---------- GALERÍA CATEGORÍAS ---------- */
.gallery{background:var(--bg)}
.cat-grid{
  display:grid;grid-template-columns:repeat(3,1fr);gap:20px;
}
@media(max-width:900px){.cat-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:560px){.cat-grid{grid-template-columns:1fr}}
.cat-card{
  position:relative;height:280px;border-radius:var(--radius);overflow:hidden;
  cursor:pointer;background:#222;box-shadow:var(--shadow);
  transition:var(--transition);
}
.cat-card:hover{transform:translateY(-6px);box-shadow:var(--shadow-lg)}
.cat-slides{position:absolute;inset:0}
.cat-slide{
  position:absolute;inset:0;width:100%;height:100%;object-fit:cover;
  opacity:0;transition:opacity 1.2s ease;
}
.cat-slide.active{opacity:1;transform:scale(1.02)}
.cat-slide-placeholder{
  position:absolute;inset:0;
  background:linear-gradient(135deg,#2c2c2e,#48484a);
  display:grid;place-items:center;color:rgba(255,255,255,.5);
}
.cat-overlay{
  position:absolute;inset:0;
  background:linear-gradient(to top,rgba(0,0,0,.75) 0%,rgba(0,0,0,.15) 50%,transparent 100%);
  display:flex;flex-direction:column;justify-content:flex-end;padding:22px;
  color:#fff;z-index:2;
}
.cat-overlay h3{font-size:1.25rem;font-weight:700;letter-spacing:-.02em}
.cat-overlay p{font-size:.85rem;opacity:.85;margin-top:4px}
.cat-overlay .arrow{
  position:absolute;top:20px;right:20px;width:36px;height:36px;border-radius:50%;
  background:rgba(255,255,255,.15);backdrop-filter:blur(10px);
  display:grid;place-items:center;transition:var(--transition);
}
.cat-card:hover .arrow{background:rgba(255,255,255,.3);transform:rotate(-45deg)}

/* ---------- MODAL GALERÍA ---------- */
.modal{
  position:fixed;inset:0;z-index:200;background:rgba(0,0,0,.92);
  display:none;opacity:0;transition:opacity .3s;
  overflow-y:auto;padding:24px;
}
.modal.open{display:block;opacity:1}
.modal-inner{max-width:1100px;margin:60px auto 40px;color:#fff}
.modal-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:28px;gap:20px}
.modal-head h2{font-size:clamp(1.4rem,3vw,2rem);font-weight:700}
.modal-close{
  width:44px;height:44px;border-radius:50%;background:rgba(255,255,255,.1);
  color:#fff;display:grid;place-items:center;font-size:1.4rem;flex-shrink:0;
  transition:var(--transition);
}
.modal-close:hover{background:rgba(255,255,255,.25);transform:rotate(90deg)}
.modal-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:16px}
.modal-grid img{
  width:100%;height:220px;object-fit:cover;border-radius:12px;
  transition:var(--transition);cursor:zoom-in;
}
.modal-grid img:hover{transform:scale(1.03);box-shadow:0 10px 30px rgba(255,255,255,.1)}
.modal-empty{
  grid-column:1/-1;padding:60px 20px;text-align:center;
  background:rgba(255,255,255,.05);border-radius:14px;color:rgba(255,255,255,.6);
  font-size:.92rem;
}

/* ---------- COTIZADOR ---------- */
.quoter{background:var(--bg-soft)}
.quoter-box{
  background:#fff;border-radius:24px;box-shadow:var(--shadow);
  overflow:hidden;display:grid;grid-template-columns:1fr 1fr;
}
@media(max-width:900px){.quoter-box{grid-template-columns:1fr}}
.quoter-form{padding:40px}
@media(max-width:600px){.quoter-form{padding:26px}}
.quoter-form h3{font-size:1.35rem;font-weight:700;margin-bottom:8px;letter-spacing:-.02em}
.quoter-form .sub{color:var(--fg-muted);font-size:.9rem;margin-bottom:26px}
.field{margin-bottom:18px}
.field label{display:block;font-size:.82rem;font-weight:600;margin-bottom:6px;color:var(--fg-muted)}
.field select,.field input[type=number],.field input[type=text]{
  width:100%;padding:12px 14px;border:1px solid var(--border);border-radius:12px;
  font-size:.95rem;background:#fff;transition:var(--transition);
  font-family:inherit;
}
.field select:focus,.field input:focus{
  outline:none;border-color:var(--accent);box-shadow:0 0 0 3px rgba(10,132,255,.12);
}
.field-row{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.measure-type{display:flex;gap:8px;margin-bottom:18px}
.measure-type button{
  flex:1;padding:10px;border-radius:10px;border:1px solid var(--border);
  font-size:.82rem;font-weight:500;color:var(--fg-muted);transition:var(--transition);
}
.measure-type button.active{background:var(--fg);color:#fff;border-color:var(--fg)}
.quoter-preview{
  background:linear-gradient(160deg,#fafafa,#f0f0f2);
  display:grid;place-items:center;padding:40px;position:relative;
  border-left:1px solid var(--border);
}
@media(max-width:900px){.quoter-preview{border-left:none;border-top:1px solid var(--border);padding:28px}}
.preview-svg{width:100%;max-width:380px;height:auto}
.preview-label{text-align:center;margin-top:16px;font-size:.82rem;color:var(--fg-muted)}
.preview-label strong{color:var(--fg);font-weight:600}
.wsp-btn{
  width:100%;margin-top:22px;padding:15px;border-radius:14px;
  background:#25D366;color:#fff;font-weight:700;font-size:.95rem;
  display:flex;align-items:center;justify-content:center;gap:10px;
  transition:var(--transition);box-shadow:0 6px 20px rgba(37,211,102,.3);
}
.wsp-btn:hover{background:#1ebe5b;transform:translateY(-2px);box-shadow:0 10px 28px rgba(37,211,102,.4)}

/* ---------- MAQUILA ---------- */
.maquila{
  background:linear-gradient(160deg,#1d1d1f,#2c2c2e);color:#fff;
  border-radius:28px;padding:70px 50px;text-align:center;
  max-width:var(--max);margin:0 auto;position:relative;overflow:hidden;
}
@media(max-width:600px){.maquila{padding:50px 24px}}
.maquila::before{
  content:'';position:absolute;top:-50%;right:-20%;width:500px;height:500px;
  background:radial-gradient(circle,rgba(10,132,255,.25),transparent 70%);
  filter:blur(40px);
}
.maquila h2{font-size:clamp(1.7rem,3.5vw,2.6rem);font-weight:800;letter-spacing:-.03em;margin-bottom:18px;position:relative}
.maquila p{color:rgba(255,255,255,.7);max-width:600px;margin:0 auto 32px;font-size:1.02rem;position:relative}
.maquila .btn-primary{background:#fff;color:#1d1d1f;box-shadow:0 6px 24px rgba(255,255,255,.2)}
.maquila .btn-primary:hover{background:#f0f0f2;transform:translateY(-2px)}

/* ---------- REDES ---------- */
.social{padding:80px 24px;text-align:center}
.social h2{font-size:clamp(1.5rem,3vw,2rem);font-weight:700;margin-bottom:12px;letter-spacing:-.02em}
.social p{color:var(--fg-muted);margin-bottom:32px}
.social-links{display:flex;gap:14px;justify-content:center;flex-wrap:wrap}
.social-links a{
  display:inline-flex;align-items:center;gap:10px;padding:13px 24px;border-radius:999px;
  border:1px solid var(--border);font-weight:500;font-size:.9rem;transition:var(--transition);
  background:#fff;
}
.social-links a:hover{transform:translateY(-3px);box-shadow:var(--shadow);border-color:transparent}
.social-links svg{width:20px;height:20px}

/* ---------- FOOTER ---------- */
.footer{
  background:var(--bg-soft);padding:50px 24px 30px;
  border-top:1px solid var(--border);
}
.footer-inner{
  max-width:var(--max);margin:0 auto;
  display:flex;justify-content:space-between;align-items:center;gap:24px;flex-wrap:wrap;
  font-size:.85rem;color:var(--fg-muted);
}
.footer-brand{display:flex;align-items:center;gap:10px;font-weight:600;color:var(--fg)}

/* ---------- ANIMACIONES SCROLL ---------- */
.reveal{opacity:0;transform:translateY(30px);transition:opacity .8s ease,transform .8s cubic-bezier(.22,.61,.36,1)}
.reveal.visible{opacity:1;transform:translateY(0)}

/* ---------- LIGHTBOX ---------- */
.lightbox{
  position:fixed;inset:0;z-index:300;background:rgba(0,0,0,.96);
  display:none;place-items:center;padding:24px;cursor:zoom-out;
}
.lightbox.open{display:grid}
.lightbox img{max-width:92vw;max-height:90vh;border-radius:10px}